<Window x:Class="SiamNetworkMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Siam Network Monitor" Width="1180" Height="760" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBrush}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="Network overview" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Live adapter and application bandwidth" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Click="Tools_Click" Margin="0,0,8,0"><TextBlock Text="Tools" Foreground="#111111"/></Button><Button Click="Settings_Click" Margin="0,0,10,0"><TextBlock Text="Settings" Foreground="#111111"/></Button><Border Background="#173B34" BorderBrush="#286455" BorderThickness="1" CornerRadius="18" Padding="14,7" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#35D6A0" Margin="0,0,8,0"/><TextBlock Text="{Binding StatusText}" Foreground="#75E5BE" FontWeight="SemiBold"/></StackPanel></Border></StackPanel>
  </Grid>
  <Grid Grid.Row="1" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="DOWNLOAD" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalDownloadText}" Foreground="{StaticResource DownloadBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="UPLOAD" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding TotalUploadText}" Foreground="{StaticResource UploadBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Grid.Column="2" Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="SESSION DOWN" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionDownloadText}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
   <Border Grid.Column="3" Style="{StaticResource Card}"><StackPanel><TextBlock Text="SESSION UP" Foreground="{StaticResource MutedBrush}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionUploadText}" FontSize="23" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Border>
  </Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,18" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CYCLE USAGE" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SummaryCycleText" Text="Loading..." FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="TOP APP TODAY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SummaryTopAppText" Text="Loading..." FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ACTIVE APPS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SummaryActiveText" Text="0" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="3"><TextBlock Text="ALERTS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold"/><TextBlock x:Name="SummaryAlertsText" Text="0 active" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel></Grid></Border><TabControl Grid.Row="3"><TabItem Header="Applications"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Application usage history" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ProcessStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="ApplicationSearchBox" Width="180" Margin="0,0,6,0" ToolTip="Search application, process or publisher" TextChanged="ApplicationSearchBox_TextChanged"/><CheckBox x:Name="ActiveOnlyBox" VerticalAlignment="Center" Margin="4,0,10,0" Checked="ActiveOnlyBox_Changed" Unchecked="ActiveOnlyBox_Changed"><TextBlock Text="Active only" Foreground="White"/></CheckBox><Button Click="PauseButton_Click" Margin="0,0,6,0"><TextBlock Text="{Binding MonitoringControlText}" Foreground="#111111"/></Button><Button Tag="0" Click="PeriodButton_Click" Padding="12,6" Margin="0,0,6,0"><TextBlock Text="Today" Foreground="#111111"/></Button><Button Tag="7" Click="PeriodButton_Click" Padding="12,6" Margin="0,0,6,0"><TextBlock Text="7 days" Foreground="#111111"/></Button><Button Tag="30" Click="PeriodButton_Click" Padding="12,6" Margin="0,0,6,0"><TextBlock Text="30 days" Foreground="#111111"/></Button><Button Click="ExportButton_Click" Padding="12,6"><TextBlock Text="Export CSV" Foreground="#111111"/></Button></StackPanel></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><DataGrid x:Name="ProcessGrid" MouseDoubleClick="ProcessGrid_MouseDoubleClick" ItemsSource="{Binding Processes}" AlternationCount="2" CanUserSortColumns="True" RowStyle="{StaticResource GridRowStyle}"><DataGrid.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#285A91"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#285A91"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/></DataGrid.Resources><DataGrid.ContextMenu><ContextMenu Style="{StaticResource GridContextMenu}"><MenuItem Click="ViewChart_Click"><MenuItem.Header><TextBlock Text="View bandwidth chart" Foreground="#111111"/></MenuItem.Header></MenuItem><Separator/><MenuItem Click="EndTask_Click"><MenuItem.Header><TextBlock Text="End task" Foreground="#B42318" FontWeight="SemiBold"/></MenuItem.Header></MenuItem><Separator/><MenuItem Foreground="#111111" Click="OpenFileLocation_Click"><MenuItem.Header><TextBlock Text="Open file location" Foreground="#111111"/></MenuItem.Header></MenuItem><MenuItem Foreground="#111111" Click="Properties_Click"><MenuItem.Header><TextBlock Text="Properties" Foreground="#111111"/></MenuItem.Header></MenuItem><MenuItem Foreground="#111111" Click="CopyPath_Click"><MenuItem.Header><TextBlock Text="Copy executable path" Foreground="#111111"/></MenuItem.Header></MenuItem></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding Description}" SortMemberPath="Description" Width="1.6*"/><DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/><DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="1.4*"/><DataGridTextColumn Header="Signature" Binding="{Binding SignedText}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="*"/><DataGridTextColumn Header="Download" Binding="{Binding DownloadText}" Width="*"/><DataGridTextColumn Header="Upload" Binding="{Binding UploadText}" Width="*"/><DataGridTextColumn Header="History download" Binding="{Binding HistoryDownloadText}" Width="*"/><DataGridTextColumn Header="History upload" Binding="{Binding HistoryUploadText}" Width="*"/><DataGridTextColumn Header="History total" Binding="{Binding HistoryTotalText}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
   <TabItem Header="Adapters"><Border Margin="0,14,0,0" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><DataGrid ItemsSource="{Binding Adapters}" AlternationCount="2" RowStyle="{StaticResource GridRowStyle}"><DataGrid.Columns><DataGridTextColumn Header="Adapter" Binding="{Binding Name}" Width="1.5*"/><DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*"/><DataGridTextColumn Header="IPv4" Binding="{Binding IPv4}" Width="*"/><DataGridTextColumn Header="Gateway" Binding="{Binding Gateway}" Width="*"/><DataGridTextColumn Header="Link" Binding="{Binding LinkSpeedText}" Width="*"/><DataGridTextColumn Header="Download" Binding="{Binding DownloadText}" Width="*"/><DataGridTextColumn Header="Upload" Binding="{Binding UploadText}" Width="*"/></DataGrid.Columns></DataGrid></Border></TabItem>
   <TabItem Header="Alerts"><Grid Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="2,0,2,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Usage alerts" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding AlertStatusText}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Click="EditRules_Click" Padding="12,6" Margin="0,0,6,0"><TextBlock Text="Edit rules" Foreground="#111111"/></Button><Button Click="AcknowledgeAlert_Click" Padding="12,6" Margin="0,0,6,0"><TextBlock Text="Acknowledge" Foreground="#111111"/></Button><Button Click="ResolveAlert_Click" Padding="12,6" Margin="0,0,6,0"><TextBlock Text="Resolve" Foreground="#111111"/></Button><Button Click="ClearAlerts_Click" Padding="12,6"><TextBlock Text="Clear history" Foreground="#111111"/></Button></StackPanel></Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><DataGrid x:Name="AlertsGrid" ItemsSource="{Binding Alerts}" AlternationCount="2" RowStyle="{StaticResource GridRowStyle}" SelectionMode="Single"><DataGrid.Resources><SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#285A91"/><SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#285A91"/><SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF"/></DataGrid.Resources><DataGrid.Columns><DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="1.2*"/><DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="*"/><DataGridTextColumn Header="Rule" Binding="{Binding Rule}" Width="1.4*"/><DataGridTextColumn Header="Application" Binding="{Binding Application}" Width="1.4*"/><DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="3*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/></DataGrid.Columns></DataGrid></Border>
   </Grid></TabItem>
  </TabControl>
  <Grid Grid.Row="4" Margin="2,13,2,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Close hides the dashboard. Use the tray menu to exit monitoring." Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{Binding LastUpdatedText}" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Grid>
 </Grid>
</Window>
