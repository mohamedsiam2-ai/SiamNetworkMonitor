<Window x:Class="SiamNetworkMonitor.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Siam Network Monitor Settings" Width="720" Height="650" MinWidth="680" MinHeight="580" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="General, meter, monitoring, alerts, and local data" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
  <TabControl Grid.Row="1">
   <TabItem Header="General"><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="StartWindowsBox" Margin="0,5,0,16"><TextBlock Text="Start Siam Network Monitor with Windows"/></CheckBox><CheckBox x:Name="StartMinimizedBox" Margin="0,0,0,16"><TextBlock Text="Start with dashboard hidden and show only the taskbar meter"/></CheckBox><CheckBox x:Name="NotificationsBox" Margin="0,0,0,16"><TextBlock Text="Show Windows notifications for triggered alerts"/></CheckBox><Border Background="#182842" CornerRadius="8" Padding="12"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Startup uses the current-user Windows Run key. Administrator-wide installation is not required."/></Border></StackPanel></Border></TabItem>
   <TabItem Header="Meter"><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><CheckBox x:Name="HideFullscreenBox" Margin="0,5,0,16"><TextBlock Text="Hide the taskbar meter while any app is full screen"/></CheckBox><TextBlock Text="Meter width"/><StackPanel Orientation="Horizontal" Margin="0,7,0,16"><TextBox x:Name="MeterWidthBox" Width="100"/><TextBlock Text="px (190–600)" Margin="10,7,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel><TextBlock Text="Meter layout"/><ComboBox x:Name="MeterLayoutBox" Width="180" HorizontalAlignment="Left" Margin="0,7,0,16"><ComboBoxItem Tag="Wide"><TextBlock Text="Wide" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="Compact"><TextBlock Text="Compact" Foreground="#111111"/></ComboBoxItem></ComboBox><Button HorizontalAlignment="Left" Click="ResetMeter_Click"><TextBlock Text="Reset meter position and width" Foreground="#111111"/></Button></StackPanel></Border></TabItem>
   <TabItem Header="Monitoring"><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Usage-history retention"/><ComboBox x:Name="RetentionBox" Width="180" HorizontalAlignment="Left" Margin="0,7,0,16"><ComboBoxItem Tag="30"><TextBlock Text="30 days" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="90"><TextBlock Text="90 days" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="180"><TextBlock Text="180 days" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="365"><TextBlock Text="365 days" Foreground="#111111"/></ComboBoxItem></ComboBox><TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="The live monitor samples every second. Historical data is aggregated hourly to limit disk usage."/></StackPanel></Border></TabItem>
   <TabItem Header="Data &amp; privacy"><Border Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock Text="Local data maintenance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><WrapPanel><Button Click="OpenDataFolder_Click" Margin="0,0,8,8"><TextBlock Text="Open data folder" Foreground="#111111"/></Button><Button Click="ExportAllHistory_Click" Margin="0,0,8,8"><TextBlock Text="Export all usage CSV" Foreground="#111111"/></Button><Button Click="ClearUsageHistory_Click" Margin="0,0,8,8"><TextBlock Text="Clear usage history" Foreground="#111111"/></Button><Button Click="ClearAlertHistory_Click" Margin="0,0,8,8"><TextBlock Text="Clear alert history" Foreground="#111111"/></Button></WrapPanel><Border Background="#182842" CornerRadius="8" Padding="12" Margin="0,8,0,0"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Siam Network Monitor stores history and settings only under %LocalAppData%\SiamNetworkMonitor. Destructive actions require confirmation."/></Border></StackPanel></Border></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><TextBlock x:Name="ValidationText" Foreground="#FF9D9D" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Click="Cancel_Click" Margin="0,0,8,0"><TextBlock Text="Cancel" Foreground="#111111"/></Button><Button Click="Save_Click"><TextBlock Text="Save settings" Foreground="#111111"/></Button></StackPanel>
 </Grid>
</Window>
