<Window x:Class="SiamNetworkMonitor.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Siam Network Monitor Settings" Width="560" Height="470" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Settings" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Startup and notification preferences" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,18"/></StackPanel>
 <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="StartWindowsBox" Margin="0,5,0,16"><TextBlock Text="Start Siam Network Monitor with Windows"/></CheckBox><CheckBox x:Name="StartMinimizedBox" Margin="0,0,0,16"><TextBlock Text="Start with dashboard hidden and show only the taskbar meter"/></CheckBox><CheckBox x:Name="NotificationsBox" Margin="0,0,0,16"><TextBlock Text="Show Windows notifications for triggered alerts"/></CheckBox><CheckBox x:Name="HideFullscreenBox" Margin="0,0,0,16"><TextBlock Text="Hide the taskbar meter while any app is full screen"/></CheckBox><Border Background="#182842" CornerRadius="8" Padding="12" Margin="0,10,0,0"><TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Text="Startup uses the current-user Windows Run key. Administrator-wide installation is not required."/></Border></StackPanel></Border>
 <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Click="Cancel_Click" Margin="0,0,8,0"><TextBlock Text="Cancel" Foreground="#111111"/></Button><Button Click="Save_Click"><TextBlock Text="Save settings" Foreground="#111111"/></Button></StackPanel></Grid>
</Window>
