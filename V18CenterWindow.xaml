<Window x:Class="SiamNetworkMonitor.V18CenterWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:SiamNetworkMonitor" Title="Siam Network Monitor Tools" Width="1040" Height="700" MinWidth="900" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,0,0,18"><TextBlock Text="Network Tools" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Data limits, connections, history, updates, and diagnostics" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
 <TabControl x:Name="CenterTabs" Grid.Row="1" SelectionChanged="CenterTabs_SelectionChanged">
  <TabItem Header="Data limit"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="USED THIS CYCLE" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="UsedText" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="REMAINING" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="RemainingText" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="FORECAST" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ForecastText" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0"><StackPanel><TextBlock x:Name="CycleText" Foreground="{StaticResource MutedBrush}"/><ProgressBar x:Name="UsageProgress" Height="18" Margin="0,12,0,8" Minimum="0" Maximum="100"/><TextBlock x:Name="PercentText" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" VerticalAlignment="Top"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition Width="180"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Allowance (GB)"/><TextBox x:Name="AllowanceBox" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Cycle start day (1-28)"/><TextBox x:Name="CycleDayBox" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><CheckBox x:Name="LimitEnabledBox"><TextBlock Text="Enable data limit"/></CheckBox><CheckBox x:Name="LimitNotificationsBox" Margin="0,8,0,0"><TextBlock Text="Notify at 50/75/90/100%"/></CheckBox></StackPanel><StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Click="TestLimitNotification_Click" Margin="0,0,8,0"><TextBlock Text="Test notification" Foreground="#111111"/></Button><Button Click="SaveLimit_Click"><TextBlock Text="Save and refresh" Foreground="#111111"/></Button></StackPanel></Grid></Border></Grid></TabItem>
  <TabItem Header="Connections"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ConnectionSearchBox" TextChanged="ConnectionSearchBox_TextChanged" ToolTip="Search app, publisher, IP, endpoint or PID"/><StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0"><TextBlock Text="Auto refresh" VerticalAlignment="Center" Margin="0,0,6,0"/><ComboBox x:Name="RefreshIntervalBox" Width="90" SelectionChanged="RefreshIntervalBox_SelectionChanged"><ComboBoxItem Tag="0"><TextBlock Text="Off" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="2"><TextBlock Text="2 sec" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="5"><TextBlock Text="5 sec" Foreground="#111111"/></ComboBoxItem><ComboBoxItem Tag="10"><TextBlock Text="10 sec" Foreground="#111111"/></ComboBoxItem></ComboBox></StackPanel><TextBlock Grid.Column="2" x:Name="ConnectionStatusText" Margin="12,0" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/><Button Grid.Column="3" Click="RefreshConnections_Click"><TextBlock Text="Refresh" Foreground="#111111"/></Button></Grid><Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ConnectionsGrid" RowStyle="{StaticResource GridRowStyle}" MouseDoubleClick="ConnectionsGrid_MouseDoubleClick"><DataGrid.ContextMenu><ContextMenu><MenuItem Header="Copy remote endpoint" Click="CopyRemote_Click"/><MenuItem Header="Open file location" Click="ConnectionOpenLocation_Click"/><Separator/><MenuItem Header="End task" Click="ConnectionEndTask_Click"/></ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="Application" Binding="{Binding Description}" Width="1.4*"/><DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding PidText}" Width="0.6*"/><DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="*"/><DataGridTextColumn Header="Local endpoint" Binding="{Binding LocalEndpoint}" Width="2*"/><DataGridTextColumn Header="Remote endpoint" Binding="{Binding RemoteEndpoint}" Width="2*"/><DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
  <TabItem Header="History charts"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button Tag="1" Click="HistoryPeriod_Click" Margin="0,0,6,0"><TextBlock Text="Today" Foreground="#111111"/></Button><Button Tag="7" Click="HistoryPeriod_Click" Margin="0,0,6,0"><TextBlock Text="7 days" Foreground="#111111"/></Button><Button Tag="30" Click="HistoryPeriod_Click"><TextBlock Text="30 days" Foreground="#111111"/></Button></StackPanel><TextBlock x:Name="HistoryStatusText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}"><local:HistoricalChartControl x:Name="HistoryChart"/></Border><Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0"><DataGrid x:Name="TopAppsGrid" RowStyle="{StaticResource GridRowStyle}"><DataGrid.Columns><DataGridTextColumn Header="Top application" Binding="{Binding Application}" Width="2*"/><DataGridTextColumn Header="Download" Binding="{Binding Download}" Width="*"/><DataGridTextColumn Header="Upload" Binding="{Binding Upload}" Width="*"/><DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/></DataGrid.Columns></DataGrid></Border></Grid></TabItem>
  <TabItem Header="Updates"><Border Style="{StaticResource Card}" Margin="0,16,0,0" VerticalAlignment="Top"><StackPanel><TextBlock Text="GitHub releases" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Open the official release page to review and download updates. Installation is never automatic." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,18"/><TextBlock x:Name="InstalledVersionText" FontSize="16" Margin="0,0,0,12"/><Button HorizontalAlignment="Left" Click="OpenReleases_Click"><TextBlock Text="Open GitHub Releases" Foreground="#111111"/></Button></StackPanel></Border></TabItem>
  <TabItem Header="Diagnostics"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10"><Button Click="RefreshDiagnostics_Click" Margin="0,0,8,0"><TextBlock Text="Refresh" Foreground="#111111"/></Button><Button Click="CopyDiagnostics_Click" Margin="0,0,8,0"><TextBlock Text="Copy report" Foreground="#111111"/></Button><Button Click="ExportDiagnostics_Click"><TextBlock Text="Export sanitized ZIP" Foreground="#111111"/></Button></StackPanel><TextBox x:Name="DiagnosticsBox" Grid.Row="1" FontFamily="Consolas" FontSize="13" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
 </TabControl></Grid>
</Window>
