<Window x:Class="SiamNetworkMonitor.AlertRuleEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Siam Network Monitor • Alert Rule Editor" Width="980" Height="680" MinWidth="820" MinHeight="540" WindowStartupLocation="CenterOwner" Background="#071827">

 <Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Alert rules" FontSize="20" FontWeight="SemiBold" Margin="16"/><ListBox x:Name="RulesList" Grid.Row="1" Margin="10,0" SelectionChanged="RulesList_SelectionChanged" DisplayMemberPath="Name" Background="#101C2E" Foreground="White" BorderThickness="0"/><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12"><Button Click="New_Click" Padding="12,7" Margin="0,0,6,0"><TextBlock Text="New" Foreground="#111"/></Button><Button Click="Delete_Click" Padding="12,7"><TextBlock Text="Delete" Foreground="#111"/></Button></StackPanel></Grid></Border>
  <Border Grid.Column="2" Style="{StaticResource Card}"><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <TextBlock Grid.ColumnSpan="2" Text="Rule configuration" Foreground="#FFFFFF" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
  <TextBlock Grid.Row="1" Text="Enabled" Margin="0,8"/><CheckBox x:Name="EnabledBox" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"/>
  <TextBlock Grid.Row="2" Text="Name" Margin="0,8"/><TextBox x:Name="NameBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="2" Grid.Column="1" Padding="8,5"/>
  <TextBlock Grid.Row="3" Text="Rule type" Margin="0,8"/><ComboBox x:Name="TypeBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="3" Grid.Column="1" Padding="6"/>
  <TextBlock Grid.Row="4" Text="Scope" Margin="0,8"/><ComboBox x:Name="ScopeBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="4" Grid.Column="1" Padding="6"/>
  <TextBlock Grid.Row="5" Text="Process name" Margin="0,8"/><TextBox x:Name="ProcessBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="5" Grid.Column="1" Padding="8,5" ToolTip="Example: msedge.exe. Leave blank for all applications."/>
  <TextBlock Grid.Row="6" Text="Usage threshold (MB)" Margin="0,8"/><TextBox x:Name="UsageBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="6" Grid.Column="1" Padding="8,5"/>
  <TextBlock Grid.Row="7" Text="Speed threshold (MB/s)" Margin="0,8"/><TextBox x:Name="SpeedBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="7" Grid.Column="1" Padding="8,5"/>
  <TextBlock Grid.Row="8" Text="Sustained seconds" Margin="0,8"/><TextBox x:Name="DurationBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="8" Grid.Column="1" Padding="8,5"/>
  <TextBlock Grid.Row="9" Text="Minimum traffic (MB)" Margin="0,8"/><TextBox x:Name="MinimumBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="9" Grid.Column="1" Padding="8,5"/>
  <TextBlock Grid.Row="10" Text="Cooldown minutes" Margin="0,8"/><TextBox x:Name="CooldownBox" Foreground="#111111" Background="#FFFFFF" Grid.Row="10" Grid.Column="1" Padding="8,5"/>
  <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><TextBlock x:Name="ValidationText" Foreground="#FF8A8A" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Click="SaveRule_Click" Padding="16,8" Margin="0,0,8,0"><TextBlock Text="Apply rule" Foreground="#111"/></Button><Button Click="SaveAll_Click" Padding="16,8"><TextBlock Text="Save and close" Foreground="#111"/></Button></StackPanel>
 </Grid></ScrollViewer></Border>
 </Grid>
</Window>
