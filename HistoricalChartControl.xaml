<UserControl x:Class="SiamNetworkMonitor.HistoricalChartControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="Transparent">
 <Grid><Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#D0122438" CornerRadius="6" Padding="9,5"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource DownloadBrush}" Margin="0,0,6,0"/><TextBlock Text="Download" FontSize="11" Margin="0,0,12,0"/><Ellipse Width="8" Height="8" Fill="{StaticResource UploadBrush}" Margin="0,0,6,0"/><TextBlock Text="Upload" FontSize="11"/></StackPanel></Border></Grid>
</UserControl>
