<Window x:Class="SiamNetworkMonitor.ApplicationChartWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Application Bandwidth Chart" Width="900" Height="520" MinWidth="680" MinHeight="420" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBrush}">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock x:Name="AppNameText" FontSize="26" FontWeight="SemiBold"/><TextBlock x:Name="ProcessText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right"><TextBlock Text="LIVE • LAST 120 SECONDS" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold"/><Button Click="Clear_Click" Margin="0,8,0,0"><TextBlock Text="Clear chart" Foreground="#111111"/></Button></StackPanel></Grid>
  <Grid Grid.Row="1" Margin="0,18,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,8,0"><StackPanel><TextBlock Text="DOWNLOAD" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="DownloadText" Foreground="{StaticResource DownloadBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,0"><StackPanel><TextBlock Text="UPLOAD" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBlock x:Name="UploadText" Foreground="{StaticResource UploadBrush}" FontSize="23" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border></Grid>
  <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12"><Grid><Canvas x:Name="ChartCanvas" SizeChanged="ChartCanvas_SizeChanged"/><Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#B3122438" CornerRadius="6" Padding="9,5"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{StaticResource DownloadBrush}" Margin="0,0,6,0"/><TextBlock Text="Download" FontSize="11" Margin="0,0,12,0"/><Ellipse Width="8" Height="8" Fill="{StaticResource UploadBrush}" Margin="0,0,6,0"/><TextBlock Text="Upload" FontSize="11"/></StackPanel></Border></Grid></Border>
  <Grid Grid.Row="3" Margin="2,12,2,0"><TextBlock x:Name="ScaleText" Foreground="{StaticResource MutedBrush}" FontSize="12"/><TextBlock Text="Updates once per second • chart history is memory-bounded" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12"/></Grid>
 </Grid>
</Window>
